{
	// Farmland being sown; replaced by farmingrevamp:farmland-*-covered with the crop once the seeds are covered
	code: "sowingfarmland",
	class: "farmingrevamp.BlockFurrowWork",
	entityClass: "farmingrevamp.SowingFarmland",
	variantgroups: [
		{ code: "state", states: ["dry", "moist"] },
		{ code: "fertility", states: ["verylow", "low", "medium", "compost", "high"] },
		{ code: "side", states: ["ns", "we"] }
	],
	// Only its cube mesh is used, cut into the heightmap columns by the block entity
	shape: { base: "game:block/basic/cube" },
	textures: {
		up: { base: "game:block/soil/farmland/fert{fertility}-{state}" },
		all: { base: "game:block/soil/fert{fertility}" }
	},
	blockmaterial: "Soil",
	sideopaque: { all: false },
	sidesolid: { all: true, up: false },
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.9375, z2: 1 },
	resistance: 2.5,
	sounds: {
		place: "game:block/dirt",
		break: "game:block/dirt",
		hit: "game:block/dirt",
		walk: "game:walk/grass"
	},
	drops: []
}
